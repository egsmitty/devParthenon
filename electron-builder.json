{
  "appId": "com.devparthenon.app",
  "productName": "Dev Parthenon",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "data/**/*",
    "assets/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      { "target": "nsis", "arch": ["x64"] },
      { "target": "portable", "arch": ["x64"] }
    ],
    "icon": "assets/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "shortcutName": "Dev Parthenon"
  }
}
